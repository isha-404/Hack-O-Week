import pandas as pd

#load csv file
df = pd.read_csv("Book1.csv")
print(df.head())

#check missing values
print(df.isnull().sum())

#remove outliners
Q1 = df.quantile(0.25)
Q3 = df.quantile(0.75)

IQR = Q3 - Q1

df = df[~((df < (Q1 - 1.5 * IQR)) | (df > (Q3 + 1.5 * IQR))).any(axis=1)]

#save cleaned_data.csv
df.to_csv("cleaned_data.csv", index=False)
print("Cleaned file saved!")
